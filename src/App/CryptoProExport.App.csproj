<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CryptoProExport</AssemblyName>
    <RootNamespace>CryptoProExport.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>CryptoPro Key Export</Product>
    <AssemblyTitle>Экспорт ключей КриптоПро с Рутокена</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\CryptoProExport.Core.csproj" />
  </ItemGroup>
  <!-- p12utility кладём рядом с приложением -->
  <ItemGroup>
    <None Include="..\..\tools\p12utility.win32.exe" Condition="Exists('..\..\tools\p12utility.win32.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>p12utility.win32.exe</Link>
    </None>
  </ItemGroup>
</Project>
