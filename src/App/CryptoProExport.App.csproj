<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CryptoProExport</AssemblyName>
    <RootNamespace>CryptoProExport.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>CryptoPro Key Export</Product>
    <AssemblyTitle>Экспорт ключей КриптоПро с Рутокена</AssemblyTitle>
    <!--
      x86 обязателен: вшитый rtCOMLite.dll 32-битный и грузится в процесс без регистрации в системе
      (RegFreeCom). В x64-процессе он работал бы только через установленный COM-суррогат.
    -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <!--
    Портативная сборка: publish одним файлом, все зависимости внутри (см. build/publish.ps1).
    Условие по RuntimeIdentifier — чтобы `dotnet publish` без -r не падал с NETSDK1097.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\CryptoProExport.Core.csproj" />
  </ItemGroup>
  <!-- та же иконка внутрь сборки: форма берёт её оттуда со всеми размерами -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico">
      <LogicalName>CryptoProExport.App.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
