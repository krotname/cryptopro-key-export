<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CryptoProExport</AssemblyName>
    <RootNamespace>CryptoProExport.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.3</Version>
    <Product>CryptoPro Key Export</Product>
    <AssemblyTitle>Экспорт ключей КриптоПро с Рутокена</AssemblyTitle>
    <!--
      x86 по умолчанию: вшитый rtCOMLite.dll 32-битный и грузится в процесс без регистрации
      в системе (RegFreeCom). В x64/arm64-процессе он работал бы только через установленный
      COM-суррогат, поэтому портативная сборка — именно x86 (она же универсальна: x86-код
      идёт и на x64 через WOW64, и на ARM64 через эмуляцию).
      Условие оставляет возможность собрать под другой RID явно — для диагностики.
    -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x86</PlatformTarget>
    <!--
      Интерфейс и сообщения программы русские, поэтому из рантайма берём сателлиты только
      русской локализации: остальные 12 языков — 8,5 МБ мёртвого веса (2,3 МБ в сжатом exe).
      На поведение не влияет — меняется лишь язык сообщений самого .NET.
    -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <!-- позволяет собирать Windows-приложение на Linux-сборщике, см. build/publish-remote.ps1 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!--
    Портативная сборка: publish одним файлом, все зависимости внутри (см. build/publish.ps1).
    Условие по RuntimeIdentifier — чтобы `dotnet publish` без -r не падал с NETSDK1097.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\CryptoProExport.Core.csproj" />
  </ItemGroup>
  <!-- та же иконка внутрь сборки: форма берёт её оттуда со всеми размерами -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico">
      <LogicalName>CryptoProExport.App.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
