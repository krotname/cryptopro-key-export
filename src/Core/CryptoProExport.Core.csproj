<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CryptoProExport.Core</AssemblyName>
    <RootNamespace>CryptoProExport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CryptoProExport.Tests" />
  </ItemGroup>
  <!--
    Внешние нативные зависимости вшиваются в сборку и распаковываются в кэш при первом запуске
    (см. BundledTools). Условие Exists — чтобы репозиторий собирался и без бинарников в tools/.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\p12utility.win32.exe"
                      Condition="Exists('..\..\tools\p12utility.win32.exe')">
      <LogicalName>CryptoProExport.Tools.p12utility.win32.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\rtCOMLite.dll"
                      Condition="Exists('..\..\tools\rtCOMLite.dll')">
      <LogicalName>CryptoProExport.Tools.rtCOMLite.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
