<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CryptoProExport.Core</AssemblyName>
    <RootNamespace>CryptoProExport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.8.0</Version>
    <!-- позволяет собирать библиотеку для Windows на Linux-сборщике -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CryptoProExport" />
    <InternalsVisibleTo Include="CryptoProExport.Tests" />
    <InternalsVisibleTo Include="CryptoProExport.WorkerFixture" />
  </ItemGroup>
  <!--
    PKCS#11 для Рутокен ЭЦП/Lite: их файловая память через rtCOMLite не видна, а PKCS#11
    показывает контейнер КриптоПро (CKO_DATA) и сертификат — оба без ввода PIN. Пакет чисто
    managed (netstandard2.0), нативная rtPKCS11ECP.dll берётся из системы (драйвер Рутокена).
    Первая внешняя зависимость Core; разрешено решением владельца от 06.08.2026 (см. AGENTS.md).
  -->
  <ItemGroup>
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
    <!--
      BouncyCastle — ГОСТ-криптография для CSP-free разбора файлового контейнера
      (ContainerKeyExtractor): Стрибог-256, ГОСТ 28147-89 (Магма) ECB и арифметика на кривых
      ГОСТ Р 34.10-2012. Чисто managed. Разрешено решением владельца от 06.08.2026 (см. AGENTS.md).
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <!--
    Внешние нативные зависимости вшиваются в сборку и распаковываются в кэш при первом запуске
    (см. BundledTools). Условие Exists — чтобы репозиторий собирался и без бинарников в tools/.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\p12utility.win32.exe"
                      Condition="Exists('..\..\tools\p12utility.win32.exe')">
      <LogicalName>CryptoProExport.Tools.p12utility.win32.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\rtCOMLite.dll"
                      Condition="Exists('..\..\tools\rtCOMLite.dll')">
      <LogicalName>CryptoProExport.Tools.rtCOMLite.dll</LogicalName>
    </EmbeddedResource>
    <!--
      Библиотеки PKCS#11 вендоров — запасной путь для машины без установленных драйверов
      носителя (Pkcs11Token.LibraryCandidates: системная копия всегда идёт первой). Копии x86,
      как и rtCOMLite: разрядность сборки по умолчанию x86, в x64-процессе вшитый кандидат
      отбрасывается по несовпадению разрядности. Рутокен S (rtPKCS11.dll) не вшит намеренно —
      он импортирует rtAPIi.dll/rtLib.dll из пакета драйверов, без которого носитель всё
      равно не появится в PC/SC.
    -->
    <EmbeddedResource Include="..\..\tools\rtPKCS11ECP.dll"
                      Condition="Exists('..\..\tools\rtPKCS11ECP.dll')">
      <LogicalName>CryptoProExport.Tools.rtPKCS11ECP.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\jcPKCS11-2.dll"
                      Condition="Exists('..\..\tools\jcPKCS11-2.dll')">
      <LogicalName>CryptoProExport.Tools.jcPKCS11-2.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\isbc_pkcs11_main.dll"
                      Condition="Exists('..\..\tools\isbc_pkcs11_main.dll')">
      <LogicalName>CryptoProExport.Tools.isbc_pkcs11_main.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\isbc_esmart_token_mod.dll"
                      Condition="Exists('..\..\tools\isbc_esmart_token_mod.dll')">
      <LogicalName>CryptoProExport.Tools.isbc_esmart_token_mod.dll</LogicalName>
    </EmbeddedResource>
    <!--
      Руководство пользователя: тоже внутрь сборки, снаружи файлов быть не должно.
      Переведено на ru и en; остальные языки интерфейса откатываются на en (см. AGENTS.md).
    -->
    <EmbeddedResource Include="guide\*.txt">
      <LogicalName>CryptoProExport.guide.%(Filename).txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!--
      Строки интерфейса: один файл на язык, вшивается ресурсом. Добавить язык = положить файл.
      WithCulture=false обязателен: без него MSBuild принял бы имена вида ru.txt / zh-Hans.txt
      за ресурсы сателлитных сборок и вынес бы их из основной сборки.
    -->
    <EmbeddedResource Include="i18n\*.txt">
      <LogicalName>CryptoProExport.i18n.%(Filename).txt</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
</Project>
